---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogPostItem from '../../components/BlogPostItem.astro';
import Tag from '../../components/Tag.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

// Count how many posts each tag appears in
const tagCounts: Record<string, number> = {};
for (const post of posts) {
  for (const tag of post.data.tags ?? []) {
    tagCounts[tag] = (tagCounts[tag] ?? 0) + 1;
  }
}

// Sort tags by post count, highest first
const tags = Object.entries(tagCounts).sort((a, b) => b[1] - a[1]);
---

<BaseLayout title="Blog" description="Thoughts on tech, life &amp; code" heroH1="KSQUARED" heroH2="A collection of thoughts on tech, life &amp; code">
  <section class="blog-container container" data-pagefind-ignore="all">
    <div class="row">
      <div class="blog-list grid-two-thirds">
        {posts.map((post) => (
          <BlogPostItem post={post} />
        ))}
      </div>

      <aside class="sidebar grid-third">
        <div class="sidebar-section">
          <h4>Tags</h4>
          <hr />
          <ul class="sidebar-tags">
            {tags.map(([tag, count]) => <Tag tag={tag} count={count} />)}
          </ul>
          <a href="/tags" class="theme-color sidebar-search-link">Search &rarr;</a>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .blog-container {
    padding-bottom: 3rem;
  }

  /* Sidebar */
  .sidebar {
    padding-top: 1rem;
  }

  .sidebar-section {
    margin-bottom: 2rem;

    h4 {
      margin-bottom: 0.25rem;
    }

    hr {
      margin-bottom: 0.75rem;
      height: 2px;
    }
  }

  .sidebar-tags {
    list-style: none;
    padding: 0;
    margin: 0 0 1rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }

  .sidebar-search-link {
    font-size: 0.875rem;
    text-decoration: underline;
  }
</style>
