---
interface Props {
  tag: string;
  count?: number;
}

const { tag, count } = Astro.props;
---

<li class="tag theme-color-bg">
  <a href={`/tags/${tag}`}>
    #{tag}{count ? ` (${count})` : null}
  </a>
</li>

<style>
  .tag {
    display: inline-block;
    border-radius: 0.25em;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.5px;
    text-transform: lowercase;
    transition: opacity 0.2s;

    &:hover {
      opacity: 0.85;
    }

    a {
      display: block;
      color: white;
      padding: 0.3em 0.6em;
      font-weight: 700;
      font-family: var(--font-mono);

      &:hover {
        color: white;
      }
    }
  }
</style>
