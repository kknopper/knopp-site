---
import { type CollectionEntry } from 'astro:content';
import Tag from './Tag.astro';

interface Props {
  post: CollectionEntry<'blog'>;
  showTags?: boolean;
}

const { post, showTags = true } = Astro.props;
const { title, pubDate, description, tags } = post.data;
---

<article class="blog-item">
  <div class="blog-header">
    <div class="blog-heading">
      <h3 class="blog-title">
        <a href={`/blog/${post.id}/`}>{title}</a>
      </h3>
      <h4 class="blog-list-date">
        {pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
      </h4>
    </div>
    <hr />
  </div>
  {description && <p>{description}</p>}
  {showTags && tags && tags.length > 0 && (
    <ul class="post-tags">
      {tags.map((tag) => <Tag tag={tag} />)}
    </ul>
  )}
  <a href={`/blog/${post.id}/`} class="blog-read-more theme-color">Read more &rarr;</a>
</article>

<style>
  .blog-item {
    margin-bottom: 2rem;

    @media (min-width: 40em) {
      max-width: 90%;
    }
  }

  .blog-header {
    margin-bottom: 1.25rem;

    hr {
      margin-bottom: 0.3125rem;
    }
  }

  .blog-heading {
    display: flex;
    align-items: baseline;
    flex-direction: column;

    @media (min-width: 45em) {
      flex-direction: row;
    }
  }

  .blog-title {
    margin: 0 0.9375rem 0 0;
    cursor: pointer;
    font-size: 1.5rem;
    order: 2;
    padding-top: 5px;

    @media (min-width: 45em) {
      order: 1;
      padding: 1em 0 0;
    }

    @media (min-width: 60em) {
      font-size: 2.25rem;
    }

    a {
      color: var(--color-black);

      &:hover {
        color: var(--theme-color);
      }
    }
  }

  .blog-list-date {
    font-size: 1.125rem;
    font-family: var(--font-primary);
    font-weight: 600;
    color: var(--color-black);
    order: 1;
    display: block;
    width: 100%;

    @media (min-width: 45em) {
      order: 2;
      width: auto;
    }

    @media (min-width: 60em) {
      font-size: 1.5rem;
    }
  }

  .blog-read-more {
    text-decoration: underline;
    transition: opacity 0.3s;

    &:hover {
      opacity: 0.75;
    }
  }

  .post-tags {
    list-style: none;
    padding: 0;
    margin: 0 0 0.75rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }
</style>
